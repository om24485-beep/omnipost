{
  "name": "omnipost",
  "version": "1.0.0",
  "description": "Keyless, local-first social video hub: sign in with Google, connect YouTube / Instagram / TikTok, see every video in one feed, cross-post anywhere, and repost from 1800+ sites.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "omnipost": "cli/omnipost.js"
  },
  "scripts": {
    "postinstall": "vite build --logLevel warn",
    "start": "node server/index.js",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js --dev\" \"vite\"",
    "build": "vite build",
    "cli": "node cli/omnipost.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "playwright-core": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
