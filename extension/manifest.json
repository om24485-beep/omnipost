{
  "manifest_version": 3,
  "name": "OmniPost Connector",
  "version": "1.0.0",
  "description": "Lets the OmniPost app on this computer use the Google, YouTube, Instagram and TikTok logins you already have in this browser.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://*.google.com/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": { "128": "icon128.png" }
}
